{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dfbustosus/llmrace/schema/race-report.json",
  "title": "llmrace race report",
  "type": "object",
  "required": ["tool", "version", "prompt", "pricing_as_of", "workload", "prompt_sha256", "request_sha256", "runs", "max_tokens", "providers"],
  "$defs": {
    "request_outcome": {
      "type": "object",
      "required": ["elapsed_ms", "attempts"],
      "properties": {
        "elapsed_ms": {"type": "number", "minimum": 0},
        "attempts": {
          "type": "array",
          "items": {"$ref": "#/$defs/request_attempt"}
        }
      }
    },
    "request_attempt": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "result"],
          "properties": {
            "status": {"const": "success"},
            "result": {"$ref": "#/$defs/run_metrics"}
          }
        },
        {
          "type": "object",
          "required": ["status", "result"],
          "properties": {
            "status": {"const": "failure"},
            "result": {"$ref": "#/$defs/round_failure"}
          }
        }
      ]
    },
    "round_failure": {
      "type": "object",
      "required": ["elapsed_ms", "class", "attempts", "message"],
      "properties": {
        "task_checked": {"type": "boolean"},
        "requests": {
          "type": "array",
          "items": {"$ref": "#/$defs/request_outcome"}
        },
        "elapsed_ms": {"type": "number", "minimum": 0},
        "class": {
          "type": "string",
          "enum": ["timeout", "rate_limit", "server", "client", "stream", "protocol", "io", "config"]
        },
        "attempts": {"type": "integer", "minimum": 1},
        "message": {"type": "string"},
        "prompt_id": {"type": "string"}
      }
    },
    "run_metrics": {
      "type": "object",
      "required": ["total_ms", "ttfb_ms", "tokens"],
      "properties": {
        "requests": {
          "type": "array",
          "items": {"$ref": "#/$defs/request_outcome"}
        },
        "total_ms": {"type": "number", "minimum": 0},
        "ttfb_ms": {"type": "number", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "chars": {"type": "integer", "minimum": 0},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "cache_read_tokens": {"type": "integer", "minimum": 0},
        "cache_write_tokens": {"type": "integer", "minimum": 0},
        "cache_write_1h_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_billed_separately": {"type": "boolean"},
        "tool_args": {"type": "string"},
        "prompt_id": {"type": "string"},
        "task_ok": {"type": ["boolean", "null"]},
        "server_ms": {"type": ["number", "null"]},
        "request_id": {"type": ["string", "null"]},
        "ratelimit_remaining": {"type": ["string", "null"]},
        "itl_gaps_ms": {
          "type": "array",
          "items": {"type": "number", "minimum": 0}
        },
        "stutters": {"type": "integer", "minimum": 0},
        "visible_tokens": {"type": "integer", "minimum": 0},
        "tokens_per_sec": {"type": "number", "minimum": 0}
      }
    }
  },
  "properties": {
    "tool": {"const": "llmrace"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "region": {"type": ["string", "null"]},
    "prompt": {"type": "string"},
    "pricing_as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "workload": {"type": "array", "items": {"type": "string"}},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runs": {"type": "integer", "minimum": 0},
    "measurement_version": {"type": "integer", "minimum": 1},
    "experiment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "experiment": {
      "type": "object",
      "required": ["measurement_version", "request_sha256", "concurrency", "warmup", "warmup_mode", "retries", "timeout_secs", "duration_secs", "variants"],
      "properties": {
        "measurement_version": {"type": "integer", "minimum": 1},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "concurrency": {"type": "integer", "minimum": 1},
        "warmup": {"type": "integer", "minimum": 0},
        "warmup_mode": {"enum": ["same-prompt", "probe"]},
        "retries": {"type": "integer", "minimum": 0},
        "timeout_secs": {"type": "integer", "minimum": 0},
        "duration_secs": {"type": ["integer", "null"], "minimum": 0},
        "variants": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}
      }
    },
    "max_tokens": {"type": "integer", "minimum": 1},
    "sampling": {
      "type": "object",
      "description": "Present only when the race pinned sampling. Omitted controls were left at the provider default.",
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "system": {"type": "string"},
        "json_output": {"type": "string", "enum": ["object", "schema"]}
      }
    },
    "regression": {
      "type": "object",
      "description": "Present only when the race was compared to a baseline. ok is false when the process exits 1 for this gate.",
      "required": ["ok", "request_mismatch", "threshold_pct", "failures"],
      "properties": {
        "ok": {"type": "boolean"},
        "status": {"enum": ["pass", "fail", "inconclusive"]},
        "inconclusive": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "model", "metric", "prompt_id", "reason"],
            "properties": {
              "provider": {"type": "string"},
              "model": {"type": "string"},
              "metric": {"type": "string"},
              "prompt_id": {"type": ["string", "null"]},
              "reason": {"type": "string"}
            }
          }
        },
        "request_mismatch": {"type": "boolean"},
        "threshold_pct": {"type": "number", "minimum": 0},
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "metric", "prompt_id", "baseline", "current", "delta_pct"],
            "properties": {
              "provider": {"type": "string"},
              "model": {"type": "string"},
              "metric": {"type": "string"},
              "prompt_id": {"type": ["string", "null"]},
              "baseline": {"type": "number"},
              "current": {"type": "number"},
              "delta_pct": {"type": "number"}
            }
          }
        }
      }
    },
    "verdict": {
      "type": ["string", "null"],
      "description": "One plain-language sentence: who leads, by how much, and whether the gap is real. Null with fewer than two successful lanes."
    },
    "significance": {
      "type": ["object", "null"],
      "properties": {
        "a": {"type": "string"},
        "b": {"type": "string"},
        "delta_ms": {"type": "number"},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "significant": {"type": "boolean"}
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "model", "successful"],
        "properties": {
          "provider": {"type": "string"},
          "model": {"type": "string"},
          "variant": {"type": ["string", "null"]},
          "concurrency": {"type": "integer", "minimum": 1},
          "successful": {"type": "boolean"},
          "error": {"type": ["string", "null"]},
          "measured_rounds": {"type": "integer", "minimum": 0},
          "failed_rounds": {"type": "integer", "minimum": 0},
          "measured_requests": {"type": "integer", "minimum": 0},
          "failed_requests": {"type": "integer", "minimum": 0},
          "request_failure_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "end_to_end_tokens_per_sec": {"type": "number", "minimum": 0},
          "failure_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "retry_attempts": {"type": "integer", "minimum": 0},
          "goodput_tokens_per_sec": {"type": "number", "minimum": 0},
          "failures": {
            "type": "array",
            "items": {"$ref": "#/$defs/round_failure"}
          },
          "runs": {
            "type": "array",
            "items": {"$ref": "#/$defs/run_metrics"}
          },
          "mean_total_ms": {"type": "number"},
          "median_total_ms": {"type": "number"},
          "p95_total_ms": {"type": "number"},
          "ci95_total_ms": {
            "type": ["array", "null"],
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
          },
          "mean_ttfb_ms": {"type": "number"},
          "ttft_ms": {"type": "number"},
          "ttfb_p50_ms": {"type": ["number", "null"]},
          "ttfb_p95_ms": {"type": ["number", "null"]},
          "tpot_p50_ms": {"type": ["number", "null"]},
          "tpot_p95_ms": {"type": ["number", "null"]},
          "mean_tokens_per_sec": {"type": "number"},
          "outlier_runs": {"type": "array", "items": {"type": "integer"}},
          "cost_per_run_usd": {"type": ["number", "null"]},
          "prompt_tokens": {"type": ["number", "null"]},
          "prompt_tokens_measured": {"type": "boolean"},
          "cache_read_tokens": {"type": ["number", "null"]},
          "cache_write_tokens": {"type": ["number", "null"]},
          "cache_write_1h_tokens": {"type": ["number", "null"]},
          "cache_discount_applied": {"type": "boolean"},
          "cache_hit_rounds": {"type": "integer", "minimum": 0},
          "server_ms": {"type": ["number", "null"]},
          "network_overhead_ms": {"type": ["number", "null"]},
          "itl_p50_ms": {"type": ["number", "null"]},
          "itl_p95_ms": {"type": ["number", "null"]},
          "stutters": {"type": "integer", "minimum": 0},
          "visible_tokens": {"type": "integer", "minimum": 0},
          "reasoning_tokens": {"type": "integer", "minimum": 0},
          "thinking_ms_estimate": {"type": ["number", "null"]},
          "request_id": {"type": ["string", "null"]},
          "task_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "task_pass": {
            "type": ["array", "null"],
            "items": {"type": "integer", "minimum": 0},
            "minItems": 2,
            "maxItems": 2
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "rounds", "mean_total_ms", "mean_ttfb_ms", "mean_tokens_per_sec"],
              "properties": {
                "id": {"type": "string"},
                "rounds": {"type": "integer", "minimum": 0},
                "failed_rounds": {"type": "integer", "minimum": 0},
                "mean_total_ms": {"type": ["number", "null"]},
                "mean_ttfb_ms": {"type": ["number", "null"]},
                "mean_tokens_per_sec": {"type": ["number", "null"]},
                "task_pass": {
                  "type": ["array", "null"],
                  "items": {"type": "integer", "minimum": 0},
                  "minItems": 2,
                  "maxItems": 2
                },
                "task_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
              }
            }
          },
          "tool_validity": {
            "type": ["array", "null"],
            "items": {"type": "integer", "minimum": 0},
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  }
}
