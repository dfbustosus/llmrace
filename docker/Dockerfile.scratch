# Truly static llmrace: a 100% musl binary on FROM scratch (~6 MB total).
#
# Build (CI does this on release tags; locally pass the version):
#   docker build --build-arg VERSION=1.3.1 --build-arg TARGET=x86_64-unknown-linux-musl \
#     -f docker/Dockerfile.scratch -t llmrace-scratch .
#
# Run:
#   docker run --rm -e OPENAI_API_KEY ghcr.io/dfbustosus/llmrace:scratch openai -n 5

FROM alpine:3.20 AS unpack
ARG VERSION=1.3.1
ARG TARGET=x86_64-unknown-linux-musl
RUN apk add --no-cache curl ca-certificates \
 && curl -fsSL \
      "https://github.com/dfbustosus/llmrace/releases/download/v${VERSION}/llmrace-v${VERSION}-${TARGET}.tar.gz" \
      -o /tmp/llmrace.tar.gz \
 && mkdir -p /out && tar xzf /tmp/llmrace.tar.gz -C /tmp \
 && cp "/tmp/llmrace-v${VERSION}-${TARGET}/bin/llmrace" /out/llmrace \
 && /out/llmrace --version

FROM scratch
COPY --from=unpack /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=unpack /out/llmrace /usr/local/bin/llmrace
# reports land in /report — mount a volume to keep them
WORKDIR /report
ENTRYPOINT ["/usr/local/bin/llmrace"]
